# Local path router — the same rules the Kubernetes ingress applies.
# Keep in sync with deploy/helm/shotlyst/values.yaml (services[].path).
:8080 {
	handle_path /api/v1/auth/*   { reverse_proxy identity:8080 }
	handle_path /api/v1/gear/*   { reverse_proxy gear:8080 }
	handle_path /api/v1/plan/*   { reverse_proxy planning:8080 }
	handle_path /api/v1/sun/*    { reverse_proxy sun:8080 }
	handle_path /api/v1/media/*  { reverse_proxy media:8080 }
	handle_path /api/v1/export/* { reverse_proxy export:8080 }
	handle                       { reverse_proxy web:5173 }
}

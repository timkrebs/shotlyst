# Values for docker-compose (hostnames resolve inside the compose network).
# For `go run` outside compose, swap postgres→localhost and minio→localhost.
SHOTLYST_DATABASE_URL=postgres://shotlyst:shotlyst@postgres:5432/shotlyst?sslmode=disable
SHOTLYST_BASE_URL=http://localhost:8080
# Caddy is the one proxy hop in Compose.
SHOTLYST_TRUSTED_PROXIES=1
SHOTLYST_S3_ENDPOINT=http://minio:9000
SHOTLYST_S3_BUCKET=shotlyst
SHOTLYST_S3_ACCESS_KEY=minioadmin
SHOTLYST_S3_SECRET_KEY=minioadmin
SHOTLYST_S3_REGION=us-east-1
SHOTLYST_AUTO_MIGRATE=true
SHOTLYST_LOG_FORMAT=text
SHOTLYST_LOG_LEVEL=debug
# Ed25519 keypair for session tokens: `go run ./cmd/keygen` prints both.
SHOTLYST_AUTH_PRIVATE_KEY=
SHOTLYST_AUTH_PUBLIC_KEY=
# Downward-API fields in the cluster; static values locally.
POD_NAME=local
POD_NAMESPACE=compose
NODE_NAME=laptop
SHOTLYST_AI_API_KEY=

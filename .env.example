# Copy to .env.local. For local development take the Supabase values from
# `supabase status -o env` (API_URL, ANON_KEY, SERVICE_ROLE_KEY).

# Browser-visible
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:55321
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Server only
SUPABASE_SERVICE_ROLE_KEY=
# The account with this email becomes workspace owner on first login.
OWNER_EMAIL=owner@shotlyst.test
# Random string; keys the hash of the client IP in the sign-in throttle.
LOGIN_THROTTLE_SECRET=
# Random string; protects /api/cron/*.
CRON_SECRET=
